{
  "name": "leptos_template",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Leptos 0.8 & Tailwind CSS v4 Frontend Template",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "trunk build --release",
    "preview": "node scripts/serve.js --release",
    "type-check": "cargo check --target wasm32-unknown-unknown",
    "lint": "cargo clippy --target wasm32-unknown-unknown --all-targets -- -D warnings",
    "format": "cargo fmt --all && prettier --write \"**/*.{html,css,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/cli": "^4.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5"
  },
  "lint-staged": {
    "*.rs": [
      "rustfmt --edition 2024"
    ],
    "*.{html,css,json,md}": [
      "prettier --write"
    ]
  }
}
